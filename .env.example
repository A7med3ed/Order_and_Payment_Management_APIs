APP_NAME="Order and Payment Management APIs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8080
APP_URL=http://localhost:${APP_PORT}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=order_payment
DB_USERNAME=app
DB_PASSWORD=local-app-password
MYSQL_ROOT_PASSWORD=local-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# JWT authentication. Setup generates the signing secret when missing.
JWT_SECRET=
JWT_TTL=60
JWT_BLACKLIST_ENABLED=true

# Reserved for the payment and idempotency sprints.
PAYMENT_CURRENCY=USD
PAYMENT_CREDIT_CARD_ENABLED=true
CREDIT_CARD_API_KEY=
CREDIT_CARD_SECRET=
PAYMENT_PAYPAL_ENABLED=true
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
IDEMPOTENCY_TTL_HOURS=24
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_DOCUMENTATION_PER_MINUTE=60
RATE_LIMIT_PAYMENTS_PER_MINUTE=10
RATE_LIMIT_PAYMENTS_PER_ORDER_PER_MINUTE=3
API_DOCUMENTATION_ENABLED=true

